# ==========================================================
# Queen Touch Technology (QTT) — .htaccess
# Canonical host, security headers, compression, caching,
# and legacy URL redirects for on-site SEO.
# ==========================================================

# ----------------------------------------------------------
# 1. Force HTTPS + force canonical host (https://www.queentouchtech.com)
#    Prevents duplicate-content indexing of http / non-www variants.
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------
  # 2. Legacy / duplicate-content redirects (301, preserves link equity)
  # ----------------------------------------------------------
  RewriteRule ^terms\.html$ /terms-of-service.html [L,R=301]
  RewriteRule ^demo-seo-2-services\.html$ /service/ [L,R=301]

  # Discontinued products (OfficePulse, QuizMaster, TableTap) -> Products hub
  RewriteRule ^products/officepulse(/.*)?$ /products/ [L,R=301]
  RewriteRule ^products/quizmaster(/.*)?$ /products/ [L,R=301]
  RewriteRule ^products/tabletap(/.*)?$ /products/ [L,R=301]

  # Old space-containing Insights URLs -> clean kebab-case URLs
  RewriteRule ^insights/local-thoothukudi-focus/How\ Smart\ Technology\ Helps\ Businesses\ Scale\ Faster/?$ /insights/local-thoothukudi-focus/how-smart-technology-helps-businesses-scale-faster/ [L,R=301,NC]
  RewriteRule ^insights/local-thoothukudi-focus/How\ Digital\ Solutions\ Are\ Helping\ Thoothukudi\ Businesses\ Grow/?$ /insights/local-thoothukudi-focus/how-digital-solutions-are-helping-thoothukudi-businesses-grow/ [L,R=301,NC]
  RewriteRule ^insights/local-thoothukudi-focus/Bringing\ Innovation\ and\ Technology\ to\ Local\ Businesses/?$ /insights/local-thoothukudi-focus/bringing-innovation-and-technology-to-local-businesses/ [L,R=301,NC]
  RewriteRule ^insights/reel-hook-style/7-reasons-your-business-may-be-losing-customers\ -every-day/?$ /insights/reel-hook-style/7-reasons-your-business-may-be-losing-customers-every-day/ [L,R=301,NC]
</IfModule>

# ----------------------------------------------------------
# 3. Custom error page
# ----------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------
# 4. Security headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------
# 5. Compression (Core Web Vitals: reduces transfer size / TTFB impact)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ----------------------------------------------------------
# 6. Browser caching (Core Web Vitals: repeat-view LCP/TTFB)
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------
# 7. Prevent directory listing
# ----------------------------------------------------------
Options -Indexes
